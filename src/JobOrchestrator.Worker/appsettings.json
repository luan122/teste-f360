{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017/?replicaSet=rs0",
    "DatabaseName": "joborchestrator"
  },
  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "Scheduler": {
    "PollIntervalSeconds": 1,
    "BatchSize": 50
  },
  "OutboxDispatcher": {
    "PollIntervalMilliseconds": 500,
    "BatchSize": 50,
    "LeaseDurationSeconds": 30
  },
  "Resilience": {
    "FailureRatio": 0.5,
    "SamplingDurationSeconds": 30,
    "MinimumThroughput": 5,
    "BreakDurationSeconds": 15,
    "ExternalDependencyBaseUrl": "https://example-external-api.local"
  }
}
